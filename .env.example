# Local PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/visioncrafter"

# JWT
JWT_SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# AWS S3 — the IAM user needs PutObject/DeleteObject on the bucket
AWS_REGION=us-west-1
AWS_ACCESS_KEY_ID=your-iam-access-key-id
AWS_SECRET_ACCESS_KEY=your-iam-secret-access-key
S3_BUCKET_NAME=vision-crafter-ai-uploads
S3_PUBLIC_BASE_URL=https://vision-crafter-ai-uploads.s3.us-west-1.amazonaws.com

# Replicate — powers every /api/ai route
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your-replicate-api-token

# Stripe — https://dashboard.stripe.com/apikeys
# STRIPE_WEBHOOK_SECRET comes from:
#   stripe listen --forward-to localhost:8000/stripe/webhook
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# App
APP_NAME=VisionCrafterAI
PORT=8000

# Base URL for Stripe success/cancel redirects
FRONTEND_URL=http://localhost:5173

# CORS: comma-separated list of allowed frontend origins
CORS_ALLOW_ORIGINS=http://localhost:5173
